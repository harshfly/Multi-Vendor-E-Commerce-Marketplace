generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum FulfilmentStatus {
  PLACED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
}

enum PayoutStatus {
  PENDING
  PROCESSED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  vendor        Vendor?
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vendor {
  id               String        @id @default(cuid())
  userId           String        @unique
  storeName        String
  slug             String        @unique
  description      String?
  logoUrl          String?
  status           VendorStatus  @default(PENDING)
  commissionBps    Int           @default(1000) // 1000 = 10.00%; admin-editable per vendor
  gatewayAccountId String?       // Razorpay linked account / Stripe acct id
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id])
  products         Product[]
  vendorOrders     VendorOrder[]
  coupons          Coupon[]
}

model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("Tree", fields: [parentId], references: [id])
  children Category[] @relation("Tree")
  products Product[]
}

model Product {
  id          String         @id @default(cuid())
  vendorId    String
  categoryId  String
  title       String
  slug        String         @unique
  description String
  pricePaise  Int
  mrpPaise    Int?
  stock       Int            @default(0)
  status      ProductStatus  @default(DRAFT)
  ratingAvg   Float          @default(0)
  ratingCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vendor      Vendor         @relation(fields: [vendorId], references: [id])
  category    Category       @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  reviews     Review[]
  orderItems  OrderItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  key       String  // S3 object key or placeholder
  url       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  type             CouponType
  value            Int                // percent (1-100) or paise
  maxDiscountPaise Int?
  minOrderPaise    Int                @default(0)
  vendorId         String?            // null = platform-wide
  usageLimit       Int?
  usedCount        Int                @default(0)
  perUserLimit     Int                @default(1)
  startsAt         DateTime
  expiresAt        DateTime
  active           Boolean            @default(true)
  vendor           Vendor?            @relation(fields: [vendorId], references: [id])
  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  userId   String
  orderId  String
  coupon   Coupon @relation(fields: [couponId], references: [id])

  @@unique([couponId, orderId])
}

model Order {
  id              String        @id @default(cuid())
  number          String        @unique // HAAT-2026-000123
  userId          String
  status          OrderStatus   @default(PENDING_PAYMENT)
  subtotalPaise   Int
  discountPaise   Int           @default(0)
  shippingPaise   Int           @default(0)
  totalPaise      Int
  couponCode      String?
  shippingAddress Json          // snapshot, not FK
  idempotencyKey  String?       @unique
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id])
  vendorOrders    VendorOrder[]
  payments        Payment[]
}

model VendorOrder {
  id                String             @id @default(cuid())
  orderId           String
  vendorId          String
  status            FulfilmentStatus   @default(PLACED)
  subtotalPaise     Int
  discountPaise     Int                @default(0)
  commissionPaise   Int
  vendorPayoutPaise Int
  trackingNumber    String?
  statusHistory     OrderStatusEvent[]
  items             OrderItem[]
  payout            Payout?
  order             Order              @relation(fields: [orderId], references: [id])
  vendor            Vendor             @relation(fields: [vendorId], references: [id])

  @@index([vendorId, status])
}

model OrderStatusEvent {
  id            String           @id @default(cuid())
  vendorOrderId String
  status        FulfilmentStatus
  note          String?
  createdAt     DateTime         @default(now())
  vendorOrder   VendorOrder      @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id             String      @id @default(cuid())
  vendorOrderId  String
  productId      String
  titleSnapshot  String
  imageSnapshot  String?
  unitPricePaise Int
  quantity       Int
  vendorOrder    VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        // "razorpay" | "stripe" | "fake"
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  amountPaise       Int
  status            PaymentStatus @default(CREATED)
  rawEvent          Json?
  createdAt         DateTime      @default(now())
  order             Order         @relation(fields: [orderId], references: [id])
}

model Payout {
  id                 String       @id @default(cuid())
  vendorOrderId      String       @unique
  providerTransferId String?      @unique
  amountPaise        Int
  status             PayoutStatus @default(PENDING)
  vendorOrder        VendorOrder  @relation(fields: [vendorOrderId], references: [id])
}

model WebhookEvent {
  id          String   @id // provider event id
  type        String
  processedAt DateTime @default(now())
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  userId           String
  rating           Int // 1..5
  title            String?
  body             String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId]) // one review per user per product
}

